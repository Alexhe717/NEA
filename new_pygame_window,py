import sys
import pygame

import board as board_mod
import Minimax as minimax_mod


BOARD_DIM = 4            
WIN_CONDITION = 4         
WINDOW_SIZE = 800         
GRID_COLOR = (50, 50, 50)
BG_COLOR = (240, 240, 240)
BLACK_STONE = (20, 20, 20)
WHITE_STONE = (235, 235, 235)
HUMAN_PIECE = 1           
AI_PIECE = 2              
LINE_WIDTH = 2
LAST_MOVE_COLOR = (200, 60, 60)
FPS = 60



def init_game():
    pygame.init()
    screen = pygame.display.set_mode((WINDOW_SIZE, WINDOW_SIZE))
    pygame.display.set_caption(f"Gomoku — Connect {WIN_CONDITION}")
    clock = pygame.time.Clock()

    game_board = board_mod.Board(BOARD_DIM)
    game_board.condition = WIN_CONDITION
    cell = WINDOW_SIZE // BOARD_DIM
    last_move = None 
    game_over = False
    outcome_text = None

    return screen, clock, game_board, cell, last_move, game_over, outcome_text


def draw_board(surface, board: board_mod.Board, cell: int, last_move):
    surface.fill(BG_COLOR)

    for i in range(BOARD_DIM):
        x = i * cell + cell // 2
        pygame.draw.line(surface, GRID_COLOR, (cell // 2, x), (WINDOW_SIZE - cell // 2, x), LINE_WIDTH)
        pygame.draw.line(surface, GRID_COLOR, (x, cell // 2), (x, WINDOW_SIZE - cell // 2), LINE_WIDTH)

    radius = max(6, (cell // 2) - 4)
    for i in range(BOARD_DIM):
        for j in range(BOARD_DIM):
            v = board.board_array[i][j]
            if v == 0:
                continue
            cx = j * cell + cell // 2
            cy = i * cell + cell // 2
            color = BLACK_STONE if v == 1 else WHITE_STONE
            pygame.draw.circle(surface, color, (cx, cy), radius)
            pygame.draw.circle(surface, (0, 0, 0), (cx, cy), radius, 1)


    if last_move is not None:
        if isinstance(last_move, tuple) and len(last_move) == 3:
            lx, ly, _ = last_move
        else:
            lx, ly = last_move
        cx = ly * cell + cell // 2
        cy = lx * cell + cell // 2
        r = max(3, radius // 3)
        pygame.draw.circle(surface, LAST_MOVE_COLOR, (cx, cy), r)


def coord_from_mouse(pos, cell):
    mx, my = pos
    i = my // cell
    j = mx // cell
    if 0 <= i < BOARD_DIM and 0 <= j < BOARD_DIM:
        return int(i), int(j)
    return None


def check_win_local(board: board_mod.Board, move):
    """Fast local win check using the last move tuple (i, j, piece)."""
    if move is None:
        return False
    i, j, piece = move
    return board.check_win_from(i, j, piece)


def ai_move(board: board_mod.Board):
    i, j = minimax_mod.best_move(board, AI_PIECE)
    if i is None or j is None:
        for r in range(BOARD_DIM):
            for c in range(BOARD_DIM):
                if board.board_array[r][c] == 0:
                    i, j = r, c
                    break
            if i is not None and j is not None:
                break
    if i is not None and j is not None and board.board_array[i][j] == 0:
        board.change_state(i, j, AI_PIECE)
        return (i, j, AI_PIECE)
    return None


def main():
    screen, clock, board, cell, last_move, game_over, outcome_text = init_game()
    ai_starts = False

    running = True
    while running:
        clock.tick(FPS)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    running = False
                elif event.key == pygame.K_r:
                    screen, clock, board, cell, last_move, game_over, outcome_text = init_game()
                    ai_starts = False
                elif event.key == pygame.K_a and not game_over:
                    if not any(board.board_array.flatten()):
                        mv = ai_move(board)
                        if mv: last_move = mv
                        if mv and check_win_local(board, mv):
                            game_over, outcome_text = True, "AI wins!"
                        elif board.check_draw():
                            game_over, outcome_text = True, "Draw"

            elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1 and not game_over:
                pos = pygame.mouse.get_pos()
                cell_rc = coord_from_mouse(pos, cell)
                if cell_rc is None:
                    continue
                i, j = cell_rc
                if board.board_array[i][j] != 0:
                    continue

                board.change_state(i, j, HUMAN_PIECE)
                last_move = (i, j, HUMAN_PIECE)
                if check_win_local(board, last_move):
                    game_over, outcome_text = True, "You win!"
                elif board.check_draw():
                    game_over, outcome_text = True, "Draw"
                if game_over:
                    continue

                if not game_over:
                    mv = ai_move(board)
                    if mv:
                        last_move = mv
                        if check_win_local(board, mv):
                            game_over, outcome_text = True, "AI wins!"
                        elif board.check_draw():
                            game_over, outcome_text = True, "Draw"

        draw_board(screen, board, cell, last_move)

        if game_over and outcome_text:
            overlay = pygame.Surface((WINDOW_SIZE, WINDOW_SIZE), pygame.SRCALPHA)
            overlay.fill((255, 255, 255, 215))
            screen.blit(overlay, (0, 0))
            font = pygame.font.SysFont(None, 56)
            sub = pygame.font.SysFont(None, 28)
            text_surf = font.render(outcome_text, True, (10, 10, 10))
            text_rect = text_surf.get_rect(center=(WINDOW_SIZE // 2, WINDOW_SIZE // 2 - 10))
            tip = sub.render("Press R to restart", True, (50, 50, 50))
            tip_rect = tip.get_rect(center=(WINDOW_SIZE // 2, WINDOW_SIZE // 2 + 30))
            screen.blit(text_surf, text_rect)
            screen.blit(tip, tip_rect)

        pygame.display.flip()

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
